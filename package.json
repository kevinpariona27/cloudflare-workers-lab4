{
  "name": "app1",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/environment.mjs local dev",
    "build": "tsc -b && node scripts/environment.mjs local build",
    "lint": "oxlint",
    "preview": "npm run build && vite preview",
    "deploy": "npm run build && wrangler deploy",
    "cf-typegen": "wrangler types",
    "dev:staging": "node scripts/environment.mjs staging dev",
    "dev:production": "node scripts/environment.mjs production dev",
    "build:staging": "tsc -b && node scripts/environment.mjs staging build",
    "build:production": "tsc -b && node scripts/environment.mjs production build",
    "typecheck": "tsc -b",
    "check": "npm run lint && npm run typecheck"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.63.2",
    "@types/node": "^24.19.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "wrangler": "^4.150.0"
  }
}
